{# check if image is uri or url #}
{% if image|render|slice(0, 9) == "public://" %}
  {% if sizes is empty %}
    {% set sizes = {'1200px':'100vw', '768px':'100vw','300px':'100vw'} %}
  {% endif %}

  {% if template is empty %}
    {% set template = "image_standard" %}
  {% endif %}

  {% if loading is empty %}
    {% set loading = "lazy" %}
  {% endif %}

  {% if sizes is not empty and template|render is not empty %}
    <picture>
      {% for key, value in image_style(sizes, template) %}
        {% set webp_srcset = styled_image_srcset(image|render, value.templates, 'image/webp') %}
        {% if webp_srcset is not empty %}
          <source type="image/webp" media="(min-width: {{ key }})" sizes="{{ value.size }}" srcset="{{ webp_srcset }}"></source>
        {% endif %}
        <source media="(min-width: {{ key }})" sizes="{{ value.size }}" srcset="{{ styled_image_srcset(image|render, value.templates) }}"></source>
      {% endfor %}
      {% set fallback = fallback_style is empty ? 'pdri__100' : fallback_style %}
      <img src="{{ styled_image_url(image|render, fallback) }}" loading="{{ loading }}" {% for key, value in attributes %}{{ key }}="{{ value }}" {% endfor %} />
    </picture>
  {% else %}
    <img src="{{ file_url(image|render) }}" loading="{{ loading }}" {% for key, value in attributes %}{{ key }}="{{ value }}" {% endfor %} />
  {% endif %}
{% else %}
  <img src="{{ image }}" loading="{{ loading }}" {% for key, value in attributes %}{{ key }}="{{ value }}" {% endfor %} />
{% endif %}
